FROM python:3.13-slim
WORKDIR /app
COPY Backend ./Backend
COPY Frontend ./Frontend
COPY local_server.py .
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
EXPOSE 8080
CMD ["python", "-c", "from local_server import Handler, ThreadingHTTPServer; ThreadingHTTPServer(('0.0.0.0',8080),Handler).serve_forever()"]
